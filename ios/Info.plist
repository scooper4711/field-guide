<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Keys Xcode can't generate, merged into the Info.plist it writes (GENERATE_INFOPLIST_FILE). -->
<plist version="1.0">
<dict>
    <!-- The iCloud container lore syncs through; the app syncs only when this is present (LoreSyncStatus). -->
    <key>LoreSyncContainer</key>
    <string>iCloud.io.github.scooper4711.FieldGuide</string>
    <!-- CKSyncEngine's silent pushes, so lore from another device arrives while the app is in the background. -->
    <key>UIBackgroundModes</key>
    <array>
        <string>remote-notification</string>
    </array>
</dict>
</plist>
