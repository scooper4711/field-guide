<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Keys Xcode can't generate, merged into the Info.plist it writes (GENERATE_INFOPLIST_FILE). -->
<plist version="1.0">
<dict>
    <!-- The iCloud container lore syncs through; the app syncs only when this is present (LoreSyncStatus). -->
    <key>LoreSyncContainer</key>
    <string>iCloud.io.github.scooper4711.FieldGuide</string>
    <!-- The suite's container the shared library and its art sync through, and its CloudKit environment; the app
         syncs the library only when this names one (tabletop-kit library sync R6.1). Signing.xcconfig sets both. -->
    <key>TablesideSyncContainer</key>
    <string>$(TABLESIDE_SYNC_CONTAINER)</string>
    <key>TablesideSyncEnvironment</key>
    <string>$(TABLESIDE_SYNC_ENVIRONMENT)</string>
    <!-- CKSyncEngine's silent pushes, so lore from another device arrives while the app is in the background. -->
    <key>UIBackgroundModes</key>
    <array>
        <string>remote-notification</string>
    </array>
</dict>
</plist>
